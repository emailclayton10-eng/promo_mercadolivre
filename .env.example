# Porta HTTP da aplicação
PORT=3000

# Credenciais do app criado em https://developers.mercadolivre.com.br/devcenter
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Deve ser exatamente igual à Redirect URI cadastrada no DevCenter (HTTPS)
ML_REDIRECT_URI=https://seu-dominio.com/auth/callback
# Site do Mercado Livre (MLB = Brasil)
ML_SITE_ID=MLB
ML_AUTH_HOST=https://auth.mercadolivre.com.br

# Requisições simultâneas à API do ML (5 é seguro; aumente com cuidado)
ML_CONCURRENCY=5

# Banco SQLite
DB_PATH=./data/promo.db

# 1 = usa uma API do Mercado Livre simulada (dados fictícios, para testes)
ML_MOCK=0

# Proteção opcional por senha (HTTP Basic Auth)
APP_USER=
APP_PASSWORD=
